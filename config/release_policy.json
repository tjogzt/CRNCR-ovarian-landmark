{
  "description": "Public code-and-results mirror. Manuscript sources, submission PDFs, the author-only Chinese edition and internal review archives are withheld.",
  "excluded_directories": [
    ".git",
    "node_modules",
    "logs",
    "__pycache__",
    ".Rproj.user",
    ".vscode",
    ".idea"
  ],
  "excluded_paths": [
    "archive",
    "config/paths.yml",
    "data/external",
    "manuscript",
    "manuscript/zh",
    "renv/library",
    "renv/staging",
    "review-stage"
  ],
  "excluded_names": [
    ".DS_Store",
    "Thumbs.db",
    ".Rhistory",
    ".RData",
    ".Ruserdata",
    ".env"
  ],
  "excluded_patterns": [
    "*.log",
    "*.pyc",
    "*.pyo",
    "*.aux",
    "*.bbl",
    "*.bcf",
    "*.blg",
    "*.fls",
    "*.fdb_latexmk",
    "*.out",
    "*.toc",
    "*.xdv",
    "*.synctex.gz",
    "*.swp",
    "*~",
    ".env.*",
    "*_review_copy_with_figures.*"
  ],
  "required_paths": [
    "README.md",
    "Makefile",
    "DESCRIPTION",
    "LICENSE",
    "LICENSE.md",
    ".gitignore",
    ".gitattributes",
    "CITATION.cff",
    ".editorconfig",
    "package.json",
    "package-lock.json",
    "renv.lock",
    "scripts",
    "R",
    "config",
    "docs",
    "environment",
    "data/processed",
    "data/supplementary",
    "results/figures/main",
    "results/figures/supplementary",
    "results/tables"
  ],
  "maximum_file_bytes": 104857600,
  "checksum_path": "docs/SHA256SUMS.txt"
}
