# File: .editorconfig
# Purpose: Apply consistent text formatting across analysis and manuscript files.
# Author: Project authors
# Created: 2026-10-15
# Inputs: Files opened or formatted by EditorConfig-aware tools.
# Outputs: Consistent UTF-8 text, indentation and final newlines.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{R,py,js,yml,yaml,json,md,tex}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
